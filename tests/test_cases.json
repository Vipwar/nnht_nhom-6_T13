{
  "metadata": {
    "topic": "T13 - Automata-based Lexical Analyzer",
    "description": "Bộ 62 test case có cấu trúc toàn diện bao gồm trường hợp hợp lệ (valid), không hợp lệ (invalid) và trường hợp biên (edge cases) cho bộ phân tích RE, chuỗi 6-chiều Automata và bộ quét từ vựng."
  },
  "single_regex_cases": [
    {
      "id": "RE-01",
      "category": "valid",
      "name": "UEH Slide 38: (a|b)*abb",
      "pattern": "(a|b)*abb",
      "accept": ["abb", "aabb", "babb", "aaabbbabb", "bababb"],
      "reject": ["", "a", "ab", "aba", "abba", "bb", "abc"]
    },
    {
      "id": "RE-02",
      "category": "valid",
      "name": "UEH Slide 46-57: (a|ba)(a|b)*ba",
      "pattern": "(a|ba)(a|b)*ba",
      "accept": ["aba", "baba", "aaba", "baabba", "abbba"],
      "reject": ["", "a", "b", "ba", "ab", "abb", "bba"]
    },
    {
      "id": "RE-03",
      "category": "valid",
      "name": "Số thực khoa học FLOAT_LIT",
      "pattern": "[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?",
      "accept": ["0.0", "3.14", "123.456", "1.5e10", "2.5E-3", "9.99e+0"],
      "reject": ["", "42", "3.", ".5", "1.2e", "1.2e+", "1.2.3", "abc"]
    },
    {
      "id": "RE-04",
      "category": "valid",
      "name": "Định danh IDENTIFIER",
      "pattern": "[a-zA-Z_][a-zA-Z0-9_]*",
      "accept": ["a", "_", "_x1", "Var_Name_99", "ifx", "WHILE"],
      "reject": ["", "0abc", "9", "a-b", "a b", "$var"]
    },
    {
      "id": "RE-05",
      "category": "edge",
      "name": "Chuỗi có escape & tiếng Việt UTF-8 STRING_LIT",
      "pattern": "\"([^\"\\\\\\n]|\\\\.)*\"",
      "accept": ["\"\"", "\"hello\"", "\"a \\\"quoted\\\" b\"", "\"path\\\\to\\\\file\"", "\"Xin chào UEH\""],
      "reject": ["", "\"", "\"unterminated", "\"line1\nline2\"", "hello"]
    },
    {
      "id": "RE-06",
      "category": "edge",
      "name": "Biểu thức nullable (a|ε)b*",
      "pattern": "(a|ε)b*",
      "accept": ["", "a", "b", "ab", "bbb", "abbb"],
      "reject": ["aa", "ba", "aba", "c"]
    },
    {
      "id": "RE-07",
      "category": "edge",
      "name": "Bình luận nhiều dòng BLOCK_COMMENT /* ... */",
      "pattern": "/\\*([^*]|\\*+[^*/])*\\*+/",
      "accept": ["/**/", "/***/", "/*** a * b ***/", "/* a / b */", "/* line1\nline2 */", "/* Tiếng Việt UEH */"],
      "reject": ["", "/*", "/*/", "/* unclosed", "/* a */ x", "/ * */"]
    },
    {
      "id": "RE-08",
      "category": "edge",
      "name": "Định lượng đếm khoảng {m,n}: Số Hex 0x[0-9a-fA-F]{2,4}",
      "pattern": "0[xX][0-9a-fA-F]{2,4}",
      "accept": ["0xFF", "0x1a2", "0XDEAD", "0x00"],
      "reject": ["0x", "0xF", "0x12345", "0xGG", "FF"]
    },
    {
      "id": "RE-09",
      "category": "edge",
      "name": "Định lượng đếm cố định {m} & cận dưới {m,}: [0-9]{4}-[0-9]{2,}",
      "pattern": "[0-9]{4}-[0-9]{2,}",
      "accept": ["2026-04", "1999-12345", "0000-00"],
      "reject": ["26-04", "2026-4", "20265-04", "2026-"]
    },
    {
      "id": "RE-10",
      "category": "edge",
      "name": "Lớp ký tự biên chứa dấu gạch nối [-a], [a-], [-]",
      "pattern": "[-a][a-][-]x",
      "accept": ["-a-x", "a--x", "---x", "aa-x"],
      "reject": ["b--x", "-aax", "--x", ""]
    },
    {
      "id": "RE-11",
      "category": "edge",
      "name": "Lớp ký tự phủ định biên [^-] và [^^]",
      "pattern": "[^-][^^]",
      "accept": ["ab", "^a", "a-", "9_"],
      "reject": ["--", "-a", "a^", "^^", "a"]
    },
    {
      "id": "RE-12",
      "category": "edge",
      "name": "Lớp ký tự chứa ngoặc vuông escape [\\[\\]\\\\] và lớp viết tắt [\\d\\w]",
      "pattern": "[\\[\\]\\\\][\\d\\w]+",
      "accept": ["[a1", "]9_", "\\x", "[UEH_2026"],
      "reject": ["a1", "[]", "\\", "[@"]
    },
    {
      "id": "RE-13",
      "category": "edge",
      "name": "Khoảng suy biến [a-a] và các escape \\{, \\}, \\/, \\f, \\v",
      "pattern": "[a-a]\\{\\/\\}[\\f\\v]",
      "accept": ["a{/}\f", "a{/}\u000b"],
      "reject": ["b{/}\f", "a{/} ", "a{/}"]
    },
    {
      "id": "RE-14",
      "category": "edge",
      "name": "Toán tử lặp lồng nhau (a*)*, (c+)+, (e?)?, f+*",
      "pattern": "(a*)*b(c+)+d(e?)?f+*",
      "accept": ["bcd", "aaabccdefff", "bcdf", "abcccdef"],
      "reject": ["", "b", "acd", "bcdeef"]
    },
    {
      "id": "RE-15",
      "category": "edge",
      "name": "Ngoặc lồng sâu & hợp nhiều nhánh (((a))|b|c|d)+",
      "pattern": "(((a))|b|c|d)+",
      "accept": ["a", "bcd", "dcba", "aaabbb"],
      "reject": ["", "e", "abcde"]
    },
    {
      "id": "RE-16",
      "category": "edge",
      "name": "Tổ hợp chuỗi ε thuần túy và nullable (ε*|\\e+)(\\e|a)ε",
      "pattern": "(ε*|\\e+)(\\e|a)ε",
      "accept": ["", "a"],
      "reject": ["aa", "b", "e"]
    }
  ],
  "invalid_regex_cases": [
    {"id": "RE-ERR-01", "name": "RE rỗng", "pattern": ""},
    {"id": "RE-ERR-02", "name": "Thiếu ngoặc đóng", "pattern": "(a|b*"},
    {"id": "RE-ERR-03", "name": "Ngoặc đóng dư thừa", "pattern": "ab)"},
    {"id": "RE-ERR-04", "name": "Ngoặc rỗng ()", "pattern": "a()b"},
    {"id": "RE-ERR-05", "name": "Toán tử * đầu biểu thức", "pattern": "*abc"},
    {"id": "RE-ERR-06", "name": "Toán tử + đầu biểu thức", "pattern": "+abc"},
    {"id": "RE-ERR-07", "name": "Toán tử ? đầu biểu thức", "pattern": "?abc"},
    {"id": "RE-ERR-08", "name": "Thiếu vế phải toán tử |", "pattern": "a|"},
    {"id": "RE-ERR-09", "name": "Thiếu vế trái | trong ngoặc (|a)", "pattern": "(|a)"},
    {"id": "RE-ERR-10", "name": "Thiếu vế phải | trong ngoặc (a|)", "pattern": "(a|)"},
    {"id": "RE-ERR-11", "name": "Hai toán tử hợp liên tiếp a||b", "pattern": "a||b"},
    {"id": "RE-ERR-12", "name": "Lớp ký tự chưa đóng [a-z", "pattern": "[a-z"},
    {"id": "RE-ERR-13", "name": "Khoảng ký tự ngược [z-a]", "pattern": "[z-a]"},
    {"id": "RE-ERR-14", "name": "Lớp ký tự rỗng []", "pattern": "[]"},
    {"id": "RE-ERR-15", "name": "Lớp ký tự phủ định rỗng [^]", "pattern": "[^]"},
    {"id": "RE-ERR-16", "name": "Lớp phủ định phủ kín toàn bộ ASCII_SIGMA", "pattern": "[^\\t\\n\\r\\v\\f -~]"},
    {"id": "RE-ERR-17", "name": "Dấu escape \\ cuối chuỗi", "pattern": "abc\\"},
    {"id": "RE-ERR-18", "name": "Định lượng đếm m > n: a{5,2}", "pattern": "a{5,2}"},
    {"id": "RE-ERR-19", "name": "Định lượng đếm không phải số: a{abc}", "pattern": "a{abc}"},
    {"id": "RE-ERR-20", "name": "Định lượng đếm vượt ngưỡng an toàn: a{100}", "pattern": "a{100}"}
  ],
