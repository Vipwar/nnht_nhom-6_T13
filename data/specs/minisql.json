{
  "id": "minisql",
  "name": "MiniSQL (Ngôn ngữ truy vấn lệnh — 14 token)",
  "description": "Minh họa khả năng sinh Lexical Analyzer tổng quát cho miền ngôn ngữ khác (SQL) chỉ bằng cách thay đổi tập Biểu thức chính quy đầu vào.",
  "tokens": [
    {
      "name": "COMMENT",
      "pattern": "--[^\\n]*",
      "priority": 1,
      "skip": true,
      "category": "comment",
      "description": "Bình luận SQL --"
    },
    {
      "name": "WHITESPACE",
      "pattern": "[ \\t\\n\\r]+",
      "priority": 2,
      "skip": true,
      "category": "whitespace",
      "description": "Khoảng trắng"
    },
    {
      "name": "KW_SELECT",
      "pattern": "SELECT|select",
      "priority": 3,
      "skip": false,
      "category": "keyword",
      "description": "Từ khóa SELECT"
    },
    {
      "name": "KW_FROM",
      "pattern": "FROM|from",
      "priority": 4,
      "skip": false,
      "category": "keyword",
      "description": "Từ khóa FROM"
    },
    {
      "name": "KW_WHERE",
      "pattern": "WHERE|where",
      "priority": 5,
      "skip": false,
      "category": "keyword",
      "description": "Từ khóa WHERE"
    },
    {
      "name": "KW_AND",
      "pattern": "AND|and",
      "priority": 6,
      "skip": false,
      "category": "keyword",
      "description": "Từ khóa AND"
    },
    {
      "name": "KW_OR",
      "pattern": "OR|or",
      "priority": 7,
      "skip": false,
      "category": "keyword",
      "description": "Từ khóa OR"
    },
    {
      "name": "NUMBER",
      "pattern": "[0-9]+(\\.[0-9]+)?",
      "priority": 8,
      "skip": false,
      "category": "literal",
      "description": "Hằng số nguyên hoặc thực"
    },
    {
      "name": "STRING",
      "pattern": "'[^'\\n\\r]*'",
      "priority": 9,
      "skip": false,
      "category": "literal",
      "description": "Chuỗi SQL trong nháy đơn"
    },
    {
      "name": "IDENT",
      "pattern": "[a-zA-Z_][a-zA-Z0-9_]*",
      "priority": 10,
      "skip": false,
      "category": "identifier",
      "description": "Tên bảng / tên cột"
    },
    {
      "name": "COMP_OP",
      "pattern": "<=|>=|<>|!=|=|<|>",
      "priority": 11,
      "skip": false,
      "category": "operator",
      "description": "Toán tử so sánh"
    },
    {
      "name": "STAR",
      "pattern": "\\*",
      "priority": 12,
      "skip": false,
      "category": "operator",
      "description": "Ký tự đại diện *"
    },
    {
      "name": "COMMA",
      "pattern": ",",
      "priority": 13,
      "skip": false,
      "category": "delimiter",
      "description": "Dấu phẩy"
    },
    {
      "name": "SEMI",
      "pattern": ";",
      "priority": 14,
      "skip": false,
      "category": "delimiter",
      "description": "Kết thúc truy vấn ;"
    }
  ]
}