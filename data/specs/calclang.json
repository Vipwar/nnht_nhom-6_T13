{
  "id": "calclang",
  "name": "CalcLang (Ngôn ngữ biểu thức gọn — 12 token, DFA trực quan)",
  "description": "Bộ ngôn ngữ nhỏ gọn (~16 trạng thái DFA tối giản) lý tưởng để quan sát toàn bộ đồ thị Combined DFA, bảng chuyển trạng thái và các bước tối thiểu hóa trực tiếp.",
  "tokens": [
    {
      "name": "WHITESPACE",
      "pattern": "[ \\t\\n\\r]+",
      "priority": 1,
      "skip": true,
      "category": "whitespace",
      "description": "Khoảng trắng (bỏ qua)"
    },
    {
      "name": "KW_LET",
      "pattern": "let",
      "priority": 2,
      "skip": false,
      "category": "keyword",
      "description": "Khai báo biến let"
    },
    {
      "name": "KW_PRINT",
      "pattern": "print",
      "priority": 3,
      "skip": false,
      "category": "keyword",
      "description": "In giá trị print"
    },
    {
      "name": "FLOAT",
      "pattern": "[0-9]+\\.[0-9]+",
      "priority": 4,
      "skip": false,
      "category": "literal",
      "description": "Số thực thập phân"
    },
    {
      "name": "INT",
      "pattern": "[0-9]+",
      "priority": 5,
      "skip": false,
      "category": "literal",
      "description": "Số nguyên"
    },
    {
      "name": "ID",
      "pattern": "[a-zA-Z_][a-zA-Z0-9_]*",
      "priority": 6,
      "skip": false,
      "category": "identifier",
      "description": "Tên biến"
    },
    {
      "name": "EQ",
      "pattern": "==",
      "priority": 7,
      "skip": false,
      "category": "operator",
      "description": "So sánh bằng =="
    },
    {
      "name": "ASSIGN",
      "pattern": "=",
      "priority": 8,
      "skip": false,
      "category": "operator",
      "description": "Phép gán ="
    },
    {
      "name": "OP_ARITH",
      "pattern": "\\+|-|\\*|/",
      "priority": 9,
      "skip": false,
      "category": "operator",
      "description": "Toán tử số học + - * /"
    },
    {
      "name": "LPAREN",
      "pattern": "\\(",
      "priority": 10,
      "skip": false,
      "category": "delimiter",
      "description": "Ngoặc mở ("
    },
    {
      "name": "RPAREN",
      "pattern": "\\)",
      "priority": 11,
      "skip": false,
      "category": "delimiter",
      "description": "Ngoặc đóng )"
    },
    {
      "name": "SEMI",
      "pattern": ";",
      "priority": 12,
      "skip": false,
      "category": "delimiter",
      "description": "Chấm phẩy ;"
    }
  ]
}