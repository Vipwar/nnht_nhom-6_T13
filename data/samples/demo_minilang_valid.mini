// Chuong trinh tinh tong va kiem tra dieu kien
func compute(n, rate) {
    let total = 0.0;
    let i = 1;
    while (i <= n && rate >= 1.5e-2) {
        if (i % 2 == 0) {
            total = total + i * rate;
        } else {
            total = total + 1;
        }
        i = i + 1;
    }
    print("Ket qua: \"OK\"", total, true);
    return total;
}
